{
  "name": "examples",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @zh-keyboard/copy-assets run copy -- --target examples",
    "postbuild": "pnpm --filter @zh-keyboard/copy-assets run copy -- --target examples --output examples/dist",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@zh-keyboard/pinyin": "workspace:*",
    "@zh-keyboard/recognizer": "workspace:*",
    "@zh-keyboard/vue": "workspace:*",
    "comlink": "^4.4.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "typescript": "~5.8.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.2.5"
  }
}
